<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiDbManager.Views.WorkspaceHeaderView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,4">
<VerticalStackLayout Grid.Column="0" Spacing="2">
    <Label Text="Database workspace" Style="{StaticResource PageTitleStyle}" />
    <Label Text="Configure the workspace one section at a time." Style="{StaticResource CompactSubtitleStyle}" />
</VerticalStackLayout>
<VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
    <Label Text="Appearance" Style="{StaticResource CompactFieldLabelStyle}" />
    <Picker
        AutomationId="ThemePicker"
        ItemsSource="{Binding ThemeOptions}"
        SelectedItem="{Binding SelectedTheme}"
        Style="{StaticResource ThemePickerStyle}" />
</VerticalStackLayout>
    </Grid>
</ContentView>
