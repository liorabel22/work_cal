<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiDbManager.Views.AmplitudeModificationSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Section 5: Amplitude Modification -->
    <Border IsVisible="{Binding HasSelectedDatabase}" Style="{StaticResource SectionCardStyle}">
<Grid ColumnDefinitions="Auto,0.9*,2.1*" ColumnSpacing="12" ToolTipProperties.Text="{Binding AmplitudeAvailabilityMessage}">
    <CheckBox Grid.Column="0" AutomationId="AmplitudeEnabledCheckBox" IsEnabled="{Binding IsAmplitudeSectionAvailable}" IsChecked="{Binding IsAmplitudeModificationEnabled}" Color="{StaticResource Primary}" ToolTipProperties.Text="{Binding AmplitudeAvailabilityMessage}" VerticalOptions="Center" />
    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
        <Label Text="Amplitude Modification" Style="{StaticResource SectionTitleStyle}" />
        <Label Text="Creates or updates low IDs in dbo.amplitude." Style="{StaticResource CompactSubtitleStyle}" />
        <Label IsVisible="{Binding IsAmplitudeSectionUnavailable}" Text="{Binding AmplitudeAvailabilityMessage}" Style="{StaticResource MissingTableMessageStyle}" ToolTipProperties.Text="{Binding AmplitudeAvailabilityMessage}" />
    </VerticalStackLayout>
    <Border
        Grid.Column="2"
        IsEnabled="{Binding IsAmplitudeModificationEnabled}"
        Style="{StaticResource ModificationFieldsStyle}">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsAmplitudeModificationEnabled}" Value="False">
                <Setter Property="Opacity" Value="0.62" />
            </DataTrigger>
        </Border.Triggers>
        <Grid ColumnDefinitions="1.25*,0.7*,0.9*" ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
                <Label Text="Low ID selector" Style="{StaticResource CompactFieldLabelStyle}" />
                <Entry
                    AutomationId="AmplitudeLowIdEntry"
                    Placeholder="1, 4, 7-10"
                    Style="{StaticResource CompactEntryStyle}"
                    Text="{Binding AmplitudeLowIdSelector}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="3">
                <HorizontalStackLayout Spacing="3">
                    <CheckBox
                        AutomationId="AmplitudeUpdateStatusCheckBox"
                        IsChecked="{Binding UpdateAmplitudeStatus}"
                        Color="{StaticResource Primary}"
                        HeightRequest="20"
                        WidthRequest="20" />
                    <Label Text="Update status" Style="{StaticResource CompactFieldLabelStyle}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Grid IsEnabled="{Binding IsAmplitudeStatusEnabled}">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsAmplitudeStatusEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.62" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <Picker
                        AutomationId="AmplitudeStatusPicker"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding AmplitudeStatus}"
                        Style="{StaticResource CompactPickerStyle}" />
                </Grid>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="3">
                <HorizontalStackLayout Spacing="3">
                    <CheckBox
                        AutomationId="AmplitudeUpdateTimeCheckBox"
                        IsChecked="{Binding UpdateAmplitudeTime}"
                        Color="{StaticResource Primary}"
                        HeightRequest="20"
                        WidthRequest="20" />
                    <Label Text="Update time" Style="{StaticResource CompactFieldLabelStyle}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <VerticalStackLayout IsEnabled="{Binding IsAmplitudeTimeEnabled}" Spacing="3">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsAmplitudeTimeEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.62" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <Border Style="{StaticResource DateTimePickerBorderStyle}">
                        <DatePicker
                            AutomationId="AmplitudeDatePicker"
                            Date="{Binding AmplitudeDate}"
                            Format="yyyy-MM-dd"
                            Style="{StaticResource CompactDatePickerStyle}" />
                    </Border>
                    <Border Style="{StaticResource DateTimePickerBorderStyle}">
                        <TimePicker
                            AutomationId="AmplitudeTimePicker"
                            Time="{Binding AmplitudeTime}"
                            Style="{StaticResource CompactTimePickerStyle}" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</Grid>
    </Border>
</ContentView>
