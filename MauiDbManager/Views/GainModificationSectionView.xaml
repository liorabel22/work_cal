<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiDbManager.Views.GainModificationSectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Section 4: Gain Modification -->
    <Border IsVisible="{Binding HasSelectedDatabase}" Style="{StaticResource SectionCardStyle}">
<Grid ColumnDefinitions="Auto,1.3*,1*" ColumnSpacing="12" ToolTipProperties.Text="{Binding GainAvailabilityMessage}">
    <CheckBox Grid.Column="0" AutomationId="GainEnabledCheckBox" IsEnabled="{Binding IsGainSectionAvailable}" IsChecked="{Binding IsGainModificationEnabled}" Color="{StaticResource Primary}" ToolTipProperties.Text="{Binding GainAvailabilityMessage}" VerticalOptions="Center" />
    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
        <Label Text="Gain Modification" Style="{StaticResource SectionTitleStyle}" />
        <Label Text="Creates or updates the (0, 0) row in dbo.gain." Style="{StaticResource CompactSubtitleStyle}" />
        <Label IsVisible="{Binding IsGainSectionUnavailable}" Text="{Binding GainAvailabilityMessage}" Style="{StaticResource MissingTableMessageStyle}" ToolTipProperties.Text="{Binding GainAvailabilityMessage}" />
    </VerticalStackLayout>
    <Grid Grid.Column="2">
        <Border
            IsEnabled="{Binding IsGainModificationEnabled}"
            Style="{StaticResource ModificationFieldsStyle}">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsGainModificationEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.62" />
                </DataTrigger>
            </Border.Triggers>
            <VerticalStackLayout Spacing="3">
                <Label Text="Status" Style="{StaticResource CompactFieldLabelStyle}" />
                <Picker
                    AutomationId="GainStatusPicker"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedItem="{Binding GainStatus}"
                    Style="{StaticResource CompactPickerStyle}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</Grid>
    </Border>
</ContentView>
