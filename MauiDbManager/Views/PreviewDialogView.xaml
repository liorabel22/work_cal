<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiDbManager.Views.PreviewDialogView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    IsVisible="{Binding IsPreviewVisible}">
<Grid
    Grid.RowSpan="2"
    Padding="24"
    BackgroundColor="{StaticResource PreviewOverlay}"
    ZIndex="20">
    <Border
    HeightRequest="620"
    MaximumHeightRequest="680"
    MaximumWidthRequest="900"
    MinimumWidthRequest="760"
    HorizontalOptions="Center"
    Style="{StaticResource PreviewDialogStyle}"
    VerticalOptions="Center">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
<Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
    <VerticalStackLayout Grid.Column="0" Spacing="2">
        <Label Text="Modification preview" Style="{StaticResource PageTitleStyle}" />
        <Label Text="Current database values compared with the pending changes." Style="{StaticResource CompactSubtitleStyle}" />
    </VerticalStackLayout>
    <Button
        Grid.Column="1"
        AutomationId="ClosePreviewButton"
        Command="{Binding ClosePreviewCommand}"
        Style="{StaticResource CompactSecondaryButtonStyle}"
        Text="Close" />
</Grid>

<Label
    Grid.Row="1"
    FontSize="13"
    FontAttributes="Bold"
    LineBreakMode="WordWrap"
    Text="{Binding PreviewMessage}"
    TextColor="{Binding PreviewMessageColor}" />

<ScrollView Grid.Row="2" Orientation="Horizontal">
    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding PreviewSummaries}" Spacing="8">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <Border Padding="10,7" Style="{StaticResource DatabaseListBorderStyle}" MinimumWidthRequest="210">
                    <VerticalStackLayout Spacing="2">
                        <Label FontSize="13" FontAttributes="Bold" Text="{Binding TableName}" />
                        <Label FontSize="12" Text="{Binding CountsText}" />
                        <Label FontSize="11" Style="{StaticResource CompactSubtitleStyle}" Text="{Binding DisplayText}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </HorizontalStackLayout>
</ScrollView>

<Grid Grid.Row="3" RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="0" BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" StrokeThickness="0">
        <Grid ColumnDefinitions="1.1*,0.65*,2.2*,2*,2*">
            <Label Grid.Column="0" Text="Table" Style="{StaticResource PreviewHeaderCellStyle}" />
            <Label Grid.Column="1" Text="Action" Style="{StaticResource PreviewHeaderCellStyle}" />
            <Label Grid.Column="2" Text="Row key" Style="{StaticResource PreviewHeaderCellStyle}" />
            <Label Grid.Column="3" Text="Current values" Style="{StaticResource PreviewHeaderCellStyle}" />
            <Label Grid.Column="4" Text="Proposed values" Style="{StaticResource PreviewHeaderCellStyle}" />
        </Grid>
    </Border>
    <CollectionView Grid.Row="1" ItemsSource="{Binding PreviewRows}" SelectionMode="None">
        <CollectionView.EmptyView>
            <Label Padding="10" Text="No preview rows are available." Style="{StaticResource CompactSubtitleStyle}" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Padding="0" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource DarkBorderColor}}" StrokeThickness="1">
                    <Grid ColumnDefinitions="1.1*,0.65*,2.2*,2*,2*">
                        <Label Grid.Column="0" Text="{Binding TableName}" Style="{StaticResource PreviewCellStyle}" />
                        <Label Grid.Column="1" FontAttributes="Bold" Text="{Binding Action}" Style="{StaticResource PreviewCellStyle}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Action}" Value="Insert">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InsertText}, Dark={StaticResource DarkInsertText}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Action}" Value="Update">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UpdateText}, Dark={StaticResource DarkUpdateText}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="2" Text="{Binding Key}" Style="{StaticResource PreviewCellStyle}" />
                        <Label Grid.Column="3" Text="{Binding CurrentValues}" Style="{StaticResource PreviewCellStyle}" />
                        <Label Grid.Column="4" Text="{Binding ProposedValues}" Style="{StaticResource PreviewCellStyle}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</Grid>

<Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
    <Label
        Grid.Column="0"
        Text="Preview is read-only. Current-time values are recalculated when Apply runs."
        Style="{StaticResource CompactSubtitleStyle}"
        VerticalOptions="Center" />
    <Button Grid.Column="1" Command="{Binding ClosePreviewCommand}" Style="{StaticResource CompactSecondaryButtonStyle}" Text="Back" />
    <Button Grid.Column="2" AutomationId="PreviewApplyButton" Command="{Binding ApplyCommand}" Style="{StaticResource CompactPrimaryButtonStyle}" Text="Apply now" />
</Grid>
    </Grid>
    </Border>
</Grid>
</ContentView>
