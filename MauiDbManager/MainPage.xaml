<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiDbManager.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiDbManager.Views"
    Title="Database workspace"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="20"
                MaximumWidthRequest="920"
                WidthRequest="840"
                Spacing="12"
                HorizontalOptions="Center">
                <views:WorkspaceHeaderView />
                <views:ConnectionSectionView />
                <views:DatabaseSelectionSectionView />
                <views:OverallModificationSectionView />
                <views:GainModificationSectionView />
                <views:AmplitudeModificationSectionView />
                <views:ZakanModificationSectionView />
            </VerticalStackLayout>
        </ScrollView>

        <views:ApplyBarView Grid.Row="1" />
        <views:PreviewDialogView Grid.RowSpan="2" ZIndex="20" />
    </Grid>
</ContentPage>
